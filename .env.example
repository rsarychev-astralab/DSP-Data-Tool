# Ключ DaData (https://dadata.ru/profile/#info)
# Для подсказок и поиска по ИНН достаточно DADATA_API_KEY.
DADATA_API_KEY=your_api_key_here

# HTTP Basic для прода. Если оба заданы, все пути кроме /health требуют логин.
DSP_BASIC_USER=
DSP_BASIC_PASSWORD=

# OpenAPI /docs по умолчанию выключен. Включить только локально: 1
DSP_ENABLE_DOCS=0

# Лимит запросов к прокси DaData (suggest/party/batch) в минуту
DADATA_RATE_LIMIT_PER_MIN=60
DADATA_MAX_JOBS=2
